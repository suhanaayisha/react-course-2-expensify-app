# Copy this file to server/.env and fill in your own values.
# server/.env is gitignored — never commit the real connection string.

# Atlas: Connect → Drivers → copy the string, replace <db_password>,
# and put the database name ("expensify") before the "?"
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/expensify?retryWrites=true&w=majority&appName=Cluster0

PORT=3000
